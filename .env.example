# CamLife 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 
# 使用方法:
# cp .env.example .env
# 然后编辑 .env 填入实际配置
#
# 重要：.env 文件包含敏感信息，请勿提交到版本控制系统

# ============================================
# 数据库配置（必需）
# ============================================
# PostgreSQL 数据库配置（用于 docker-compose）
POSTGRES_DB=camlife
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# 注意：DATABASE_URL 会自动从上面的配置生成，无需手动设置
# docker-compose 会自动构建连接字符串：
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ============================================
# 应用配置
# ============================================
# 应用运行端口（默认 3000）
PORT=3000

# Node 环境（production / development）
NODE_ENV=production

# ============================================
# 认证配置（必需）
# ============================================
# BetterAuth 密钥（用于加密会话和令牌）
# 生成方法: openssl rand -base64 32
# 重要：生产环境必须使用强随机密钥，不要使用默认值！
BETTER_AUTH_SECRET=your_better_auth_secret_here

# BetterAuth 应用基础 URL
# 本地开发: http://localhost:3000
# 生产环境: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# ============================================
# 存储服务配置（必需，用于上传照片）
# ============================================
# 详细配置指南请查看: STORAGE-SETUP.md
# 
# 支持的存储提供商:
# - cloudflare-r2 (推荐，免费额度高)
# - tencent-cos (腾讯云对象存储)
# - aws-s3 (亚马逊 S3)
# - vercel-blob (Vercel Blob 存储)
STORAGE_PROVIDER=cloudflare-r2

# ============================================
# Cloudflare R2 配置 (当 STORAGE_PROVIDER=cloudflare-r2 时需要)
# ============================================
# Endpoint 格式: https://<account-id>.r2.cloudflarestorage.com
# Account ID 可以在 Cloudflare Dashboard 右侧栏找到
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# 存储桶名称
CLOUDFLARE_R2_BUCKET=your-bucket-name

# 区域（通常使用 auto）
CLOUDFLARE_R2_REGION=auto

# API Token（在 Cloudflare R2 → Manage R2 API Tokens 中创建）
# 需要 Object Read & Write 权限
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key

# 文件前缀（可选，用于组织文件）
CLOUDFLARE_R2_PREFIX=camlife

# 公共访问 URL（必需，用于预览图片）
# 配置方法：Cloudflare Dashboard → R2 → 存储桶 → Settings → Public Access
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-url.com

# ============================================
# 腾讯云 COS 配置 (当 STORAGE_PROVIDER=tencent-cos 时需要)
# ============================================
# 在腾讯云控制台 → 访问管理 → API密钥管理 中获取
# TENCENT_COS_SECRET_ID=your-secret-id
# TENCENT_COS_SECRET_KEY=your-secret-key

# 存储桶名称（格式: bucket-appid，如 camlife-1234567890）
# TENCENT_COS_BUCKET=your-bucket-1234567890

# 存储桶所在地域（如 ap-shanghai, ap-guangzhou, ap-beijing）
# 地域列表: https://cloud.tencent.com/document/product/436/6224
# TENCENT_COS_REGION=ap-shanghai

# 文件前缀（可选，用于组织文件）
# TENCENT_COS_PREFIX=camlife

# 公共访问 URL（必需，用于预览图片）
# 格式: https://<bucket>.cos.<region>.myqcloud.com
# 或使用 CDN 加速域名
# TENCENT_COS_PUBLIC_URL=https://your-bucket-1234567890.cos.ap-shanghai.myqcloud.com

# ============================================
# 地图服务说明
# ============================================
# 项目使用 MapLibre GL JS（开源免费）和 Nominatim（OpenStreetMap 地理编码服务）
# 无需配置任何 API Key，地图功能开箱即用
#
# MapLibre: https://maplibre.org/
# Nominatim: https://nominatim.openstreetmap.org/

# ============================================
# 分析工具（可选）
# ============================================
NEXT_PUBLIC_UMAMI_ANALYTICS_ID=
NEXT_PUBLIC_UMAMI_ANALYTICS_JS=

# ============================================
# 构建配置
# ============================================
# 跳过环境变量验证（Docker 构建时使用）
SKIP_ENV_VALIDATION=true

# ============================================
# 注册限制（可选）
# ============================================
# 允许注册的邮箱列表，多个邮箱用逗号分隔
# 如果不设置或为空，则遵循默认规则（仅允许第一个用户注册）
# 示例: ALLOWED_EMAILS=admin@example.com,user@example.com
# ALLOWED_EMAILS=your-email@example.com
