# 本地开发环境变量示例
# 复制此文件为 .env.local 并填入实际值
# 
# 使用方法:
# cp env.local.example .env.local
# 然后编辑 .env.local 填入实际配置

# ============================================
# 数据库配置
# ============================================
# 数据库连接（开发环境会自动使用 docker-compose-dev.yml 中的配置）
# DATABASE_URL 会在 docker-compose-dev.yml 中自动设置，无需在此配置

# ============================================
# 地图服务配置（可选）
# ============================================
# 项目使用 MapLibre GL JS（开源免费）和 Nominatim（OpenStreetMap 地理编码服务）
# 默认使用免费的地图样式，无需配置即可使用
# 
# 可选：配置 MapTiler API Key 以获得更好的地图样式（支持深色模式、更多样式选择）
# 1. 注册账号: https://cloud.maptiler.com/
# 2. 创建 API Key: https://cloud.maptiler.com/account/keys/
# 3. 免费额度: 每月 100,000 次地图加载（足够个人使用）
# 4. 将 API Key 填入下方配置
#
# MapLibre: https://maplibre.org/
# Nominatim: https://nominatim.openstreetmap.org/
# MapTiler: https://www.maptiler.com/
NEXT_PUBLIC_MAPTILER_API_KEY=

# ============================================
# 存储服务配置（必需，用于上传照片）
# ============================================
# 详细配置指南请查看: STORAGE-SETUP.md
# 
# 存储提供商: cloudflare-r2, aws-s3, vercel-blob
STORAGE_PROVIDER=cloudflare-r2

# Cloudflare R2 配置
# Endpoint 格式: https://<account-id>.r2.cloudflarestorage.com
# Account ID 可以在 Cloudflare Dashboard 右侧栏找到
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# 存储桶名称（在 Cloudflare R2 Dashboard 中创建的存储桶名称）
CLOUDFLARE_R2_BUCKET=your-bucket-name

# 区域（通常使用 auto）
CLOUDFLARE_R2_REGION=auto

# API Token（在 Cloudflare R2 → Manage R2 API Tokens 中创建）
# 需要 Object Read & Write 权限
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key

# 文件前缀（可选，用于组织文件，例如: camlife/）
CLOUDFLARE_R2_PREFIX=camlife

# 公共访问 URL（必需，用于预览图片）
# 如果不配置，上传的图片将无法在浏览器中预览！
# 
# 配置方法：
# 1. 在 Cloudflare Dashboard → R2 → 您的存储桶 → Settings → Public Access
# 2. 点击 "Allow Access" → 选择 "R2.dev subdomain" 或 "Connect Custom Domain"
# 3. 复制生成的公共 URL，填入下面的配置
#
# 选项 A：使用 R2.dev 子域名（推荐，最简单）
# 格式: https://pub-xxxxx.r2.dev
# 在存储桶设置 → Public Access → R2.dev subdomain 中启用
#
# 选项 B：使用自定义域名（生产环境推荐）
# 格式: https://your-custom-domain.com
# 在存储桶设置 → Public Access → Connect Custom Domain 中配置
#
# 重要：确保此 URL 与存储桶设置中的公共 URL 完全一致！
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-url.com

# 上传方式（可选）
# 本地开发：默认使用服务器端代理（无需配置 CORS，推荐）
# 生产环境：可以设置为 false 使用直接上传（需要配置 CORS）
# 默认: 开发环境自动使用代理，生产环境使用直接上传
# NEXT_PUBLIC_USE_UPLOAD_PROXY=true  # 强制使用代理
# NEXT_PUBLIC_USE_UPLOAD_PROXY=false # 强制使用直接上传（需要 CORS）

# ============================================
# 分析工具（可选）
# ============================================
NEXT_PUBLIC_UMAMI_ANALYTICS_ID=
NEXT_PUBLIC_UMAMI_ANALYTICS_JS=

